<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D15"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="44dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription=""
            android:src="@drawable/debt_collect_logo" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Welcome back"
            android:textColor="#F5F7FA"
            android:textSize="30sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:text="Sign in to manage your collections."
            android:textColor="#8E9BAC"
            android:textSize="15sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/demo_badge_background"
            android:padding="12dp"
            android:text="Demo: demo@debtcollect.app  •  DebtCollect1!"
            android:textColor="#9FE5D6"
            android:textSize="12sp" />

        <TextView style="@style/AuthFieldLabel" android:text="Email address" />
        <EditText
            android:id="@+id/emailInput"
            style="@style/AuthInput"
            android:hint="you@example.com"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress" />
        <TextView android:id="@+id/emailError" style="@style/AuthFieldError" />

        <TextView style="@style/AuthFieldLabel.Spaced" android:text="Password" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <EditText
                android:id="@+id/passwordInput"
                style="@style/AuthInput"
                android:hint="Enter your password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:paddingEnd="72dp" />
            <TextView
                android:id="@+id/passwordToggle"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center"
                android:text="@string/show_password"
                android:textColor="#54BFA9"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
        <TextView android:id="@+id/passwordError" style="@style/AuthFieldError" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <CheckBox
                android:id="@+id/rememberEmail"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:buttonTint="#57D1B3"
                android:text="Remember email"
                android:textColor="#AAB5C4"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/forgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="Forgot password?"
                android:textColor="#54BFA9"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/loginError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/error_background"
            android:padding="12dp"
            android:textColor="#FFB1B1"
            android:textSize="13sp"
            android:visibility="gone" />
        <Button
            android:id="@+id/signInButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/button_background"
            android:text="Sign in"
            android:textAllCaps="false"
            android:textColor="#07120F"
            android:textSize="16sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/loginProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:indeterminateTint="#57D1B3"
            android:visibility="gone" />
        <TextView
            android:id="@+id/createAccount"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="New to Debt Collect?  Create account"
            android:textColor="#AAB5C4"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
