<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D15"
    android:fillViewport="true"
    android:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="32dp"
        android:paddingEnd="28dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/backToLogin"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹  Back to sign in"
            android:textColor="#54BFA9"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription=""
            android:src="@drawable/debt_collect_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Create your account"
            android:textColor="#F5F7FA"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Enter your details. We’ll verify your email with a one-time code."
            android:textColor="#8E9BAC"
            android:textSize="15sp" />

        <TextView style="@style/AuthFieldLabel" android:text="First name" />
        <EditText
            android:id="@+id/signupFirstName"
            style="@style/AuthInput"
            android:hint="Juan"
            android:inputType="textPersonName"
            android:imeOptions="actionNext" />
        <TextView android:id="@+id/signupFirstNameError" style="@style/AuthFieldError" />

        <TextView style="@style/AuthFieldLabel.Spaced" android:text="Last name" />
        <EditText
            android:id="@+id/signupLastName"
            style="@style/AuthInput"
            android:hint="Dela Cruz"
            android:inputType="textPersonName"
            android:imeOptions="actionNext" />
        <TextView android:id="@+id/signupLastNameError" style="@style/AuthFieldError" />

        <TextView style="@style/AuthFieldLabel.Spaced" android:text="Email address" />
        <EditText
            android:id="@+id/signupEmail"
            style="@style/AuthInput"
            android:hint="you@example.com"
            android:inputType="textEmailAddress"
            android:imeOptions="actionNext" />
        <TextView android:id="@+id/signupEmailError" style="@style/AuthFieldError" />

        <TextView style="@style/AuthFieldLabel.Spaced" android:text="Mobile number" />
        <EditText
            android:id="@+id/signupPhone"
            style="@style/AuthInput"
            android:hint="+639171234567"
            android:inputType="phone"
            android:imeOptions="actionNext" />
        <TextView android:id="@+id/signupPhoneError" style="@style/AuthFieldError" />

        <TextView style="@style/AuthFieldLabel.Spaced" android:text="Password" />
        <EditText
            android:id="@+id/signupPassword"
            style="@style/AuthInput"
            android:hint="At least 8 characters"
            android:inputType="textPassword"
            android:imeOptions="actionNext" />
        <TextView android:id="@+id/signupPasswordError" style="@style/AuthFieldError" />

        <TextView style="@style/AuthFieldLabel.Spaced" android:text="Confirm password" />
        <EditText
            android:id="@+id/signupConfirmPassword"
            style="@style/AuthInput"
            android:hint="Re-enter your password"
            android:inputType="textPassword"
            android:imeOptions="actionDone" />
        <TextView android:id="@+id/signupConfirmPasswordError" style="@style/AuthFieldError" />

        <CheckBox
            android:id="@+id/signupTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:buttonTint="#57D1B3"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="I agree to the Terms of Service and Privacy Policy"
            android:textColor="#AAB5C4"
            android:textSize="13sp" />
        <TextView android:id="@+id/signupTermsError" style="@style/AuthFieldError" />

        <TextView
            android:id="@+id/signupGeneralError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/error_background"
            android:padding="12dp"
            android:textColor="#FFB1B1"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/createAccountButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/button_background"
            android:text="Create account"
            android:textAllCaps="false"
            android:textColor="#07120F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/signupProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:indeterminateTint="#57D1B3"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
